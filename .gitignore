# Publish only the reviewed source files. All local data is private by default.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/setup_windows.py
!/open-web.cmd
!/webapp/
!/work/
!/tests/

/webapp/*
!/webapp/server.py
!/webapp/launch.py
!/webapp/xianyu.py
!/webapp/static/
/webapp/static/*
!/webapp/static/index.html
!/webapp/static/style.css
!/webapp/static/app.js
!/webapp/static/xianyu.js

/work/*
!/work/run_mediacrawler.py
!/work/xianyu_web_worker.py
!/work/xianyu_collect.py
!/work/xianyu_probe.py
!/work/xianyu_details.py

/tests/*
!/tests/test_repository.py

**/__pycache__/
*.pyc
.env
.env.*
*.log
*.pem
*.key
